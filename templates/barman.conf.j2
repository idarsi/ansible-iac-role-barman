[barman]
barman_home = {{ barman_home }}
{% for key, value in barman_global_config.items() %}
{% if key != 'barman_home' %}
{{ key }} = {{ value }}
{% endif %}
{% endfor %}

configuration_files_directory = {{ barman_server_config_dir }}
log_file = {{ barman_log_directory }}/barman.log
log_level = INFO
